NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/nutriverse
SALT_ROUND=10
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:5174
REDIS_URL=rediss://default:<your-upstash-password>@<your-upstash-host>:6379

# API Keys
GEMINI_API_KEY=your_gemini_api_key
FOOD_DATA_API_KEY=your_usda_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
RECIPE_IMAGE_API_KEY=your_unsplash_access_key

# Cloudinary AI Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
